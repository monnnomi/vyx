DATABASE_URL=
VYX_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional conservative budget for task-verification reads only (100 cents/day by default).
X_TASK_DAILY_BUDGET_CENTS=100
VYX_ADMIN_X_IDS=
PUBLIC_APP_URL=https://joinvyx.com
CRON_SECRET=

# Optional overrides for public analytics counter IDs; applied at deployment.
GA4_MEASUREMENT_ID=
YANDEX_METRIKA_ID=

# Private Blob store for photo/video attachments (server-side only)
BLOB_READ_WRITE_TOKEN=

# Newsroom credentials; automation starts paused with no sources. Never use end-user OAuth tokens.
X_NEWS_BEARER_TOKEN=
# News-only provider settings. Values remain server-side. Defaults use official OpenAI.
VYX_NEWS_AI_BASE_URL=https://api.openai.com/v1
VYX_NEWS_AI_MODEL=gpt-5.4-mini-2026-03-17
VYX_NEWS_AI_API_KEY=
# Optional legacy key fallback, official OpenAI endpoint only.
OPENAI_API_KEY=
